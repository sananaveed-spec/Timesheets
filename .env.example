VITE_AZURE_CLIENT_ID=your-application-client-id
VITE_AZURE_TENANT_ID=your-directory-tenant-id
# Restrict login to this domain (default: epsfresno.com)
VITE_ALLOWED_EMAIL_DOMAIN=epsfresno.com

# Clockify API (server-only — used by Vite /api/clockify proxy, not exposed to the browser)
CLOCKIFY_API_KEY=your_clockify_api_key_here
CLOCKIFY_WORKSPACE_ID=your_workspace_id_here
CLOCKIFY_WORKSPACE_TIMEZONE=America/Los_Angeles
